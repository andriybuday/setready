# Copy the names (not real values) into .dev.vars for local development.
# .dev.vars is git-ignored. Production values go in Cloudflare secrets:
#   wrangler secret put SETLISTFM_API_KEY
ADMIN_TOKEN=
SETLISTFM_API_KEY=
TICKETMASTER_API_KEY=
GOOGLE_CLOUD_PROJECT=
# Google OAuth (Web application client in that Cloud project).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Refresh token for the dedicated SetReady channel (added by the one-time
# OAuth callback flow during implementation).
YOUTUBE_REFRESH_TOKEN=
# Spotify app credentials (Client ID is not secret; secret goes only here
# or in Cloudflare secrets, never in chat/git).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
